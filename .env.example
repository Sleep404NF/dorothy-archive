# DOROTHY 설정 예시. 이 파일을 .env 로 복사해서 쓴다 (.env 는 git 에 올라가지 않는다).
#   cp .env.example .env
# 아무것도 설정하지 않으면 SQLite + 로컬 폴더 + inline 큐로 Docker 없이 돈다.

# --- 작업 큐 (docker compose 의 redis) ---
# DOROTHY_QUEUE=celery
# DOROTHY_REDIS_URL=redis://127.0.0.1:6379/0

# --- DB (docker compose 의 postgres) ---
# DOROTHY_DATABASE_URL=postgresql+psycopg://dorothy:dorothy@127.0.0.1:5432/dorothy

# --- 이미지 저장소 (docker compose 의 s3 = RustFS, S3 호환) ---
# DOROTHY_STORAGE=s3
# DOROTHY_S3_ENDPOINT=http://127.0.0.1:9000
# DOROTHY_S3_BUCKET=dorothy
# DOROTHY_S3_ACCESS_KEY=dorothy
# DOROTHY_S3_SECRET_KEY=dorothy-secret

# Cloudflare R2 를 쓸 때 예시 (엔드포인트는 R2 대시보드의 계정 ID 로 바꾼다)
# DOROTHY_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DOROTHY_S3_REGION=auto
